# admin/.env.example - template for admin/.env (copy it, then adjust).
# The real admin/.env is never committed. Only this example file is.
# IMPORTANT: anything starting with VITE_ is bundled into the app and visible in the
# browser. Never put a secret, password or token in this file.

# Base URL of the API. The ONLY switch between mock and real:
#   mock API (Prism): http://localhost:4010
#   real API:         http://localhost:4000
VITE_API_BASE_URL=http://localhost:4010
