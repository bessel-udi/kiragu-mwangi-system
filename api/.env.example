# api/.env.example - template for api/.env (copy it, then fill in your own values).
# The real api/.env is never committed. Only this example file is.
# Every variable below is required by the API; it fails fast at startup if one is missing.

# ---- Server ----
# Runtime mode: development, test or production
NODE_ENV=development
# Port the real API listens on (the mock API uses 4010, web 5173, admin 5174)
PORT=4000
# Timezone used for all booking dates, slots and report times
APP_TIMEZONE=Africa/Nairobi

# ---- Database (MySQL 8) ----
# Host where MySQL runs
DB_HOST=localhost
# MySQL port
DB_PORT=3306
# Database name created in Phase 2
DB_NAME=kiragu_mwangi
# Application user with data privileges only (never root)
DB_USER=km_app
# Password you chose for km_app. Leave empty here, fill in only in your own .env
DB_PASSWORD=

# ---- Authentication and cookies ----
# Secret used to sign session tokens. Use a long random value, different per environment.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# How long a session lasts (for example 7d or 12h)
JWT_EXPIRES_IN=7d
# Name of the HttpOnly session cookie. Fixed by the project: session
COOKIE_NAME=session
# true in production (HTTPS only), false for local http development
COOKIE_SECURE=false
# lax, strict or none. Local development uses lax; production values are set in Phase 12
COOKIE_SAMESITE=lax
# Cookie domain. Leave empty locally; in production set the shared parent domain
COOKIE_DOMAIN=

# ---- CORS and public URLs ----
# Comma-separated list of allowed front-end origins (web and admin)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Base URL of the public website; used to build the password reset link
WEB_BASE_URL=http://localhost:5173
# Base URL of the admin panel
ADMIN_BASE_URL=http://localhost:5174
# Public base URL of this API; used to build links to uploaded images
PUBLIC_API_URL=http://localhost:4000

# ---- File uploads ----
# Folder where uploaded property images are stored (ignored by git)
UPLOAD_DIR=./uploads
# Maximum size of one uploaded image in megabytes
MAX_UPLOAD_MB=5
# Storage driver: local (disk) for now; an object-storage driver may be added later
STORAGE_DRIVER=local

# ---- Email (Nodemailer SMTP) ----
# SMTP server host. Development uses a Mailtrap sandbox inbox. Fill in your own.
SMTP_HOST=
# SMTP port (Mailtrap commonly uses 2525)
SMTP_PORT=2525
# SMTP username from your sandbox inbox
SMTP_USER=
# SMTP password from your sandbox inbox. Never commit it.
SMTP_PASSWORD=
# Sender shown on outgoing emails, for example: Kiragu & Mwangi <no-reply@yourdomain>
MAIL_FROM=

# ---- WhatsApp (Meta Cloud API) ----
# stub = log the message only (default, safe); live = send through Meta
WHATSAPP_DRIVER=stub
# Phone Number ID from the Meta app (live driver only)
WHATSAPP_PHONE_NUMBER_ID=
# Access token from the Meta app (live driver only). Never commit it.
WHATSAPP_ACCESS_TOKEN=
# Name of the approved message template used for admin alerts
WHATSAPP_TEMPLATE_NAME=
# Comma-separated admin WhatsApp numbers in international format without +, for example 2547XXXXXXXX
WHATSAPP_RECIPIENTS=

# ---- Seed script (creates the first users; see api/scripts/seed-users) ----
# Email for the seeded superadmin
SEED_SUPERADMIN_EMAIL=
# Password for the seeded superadmin (8 to 72 characters). Fill in only in your own .env
SEED_SUPERADMIN_PASSWORD=
# Email for the seeded admin
SEED_ADMIN_EMAIL=
# Password for the seeded admin (8 to 72 characters)
SEED_ADMIN_PASSWORD=
# Shared password for the seeded demo clients (8 to 72 characters)
SEED_CLIENT_PASSWORD=
