# web/.env.example - template for web/.env (copy it, then adjust).
# The real web/.env is never committed. Only this example file is.
# IMPORTANT: anything starting with VITE_ is bundled into the public site and visible
# to every visitor. Never put a secret, password or token in this file.

# Base URL of the API. The ONLY switch between mock and real:
#   mock API (Prism): http://localhost:4010
#   real API:         http://localhost:4000
VITE_API_BASE_URL=http://localhost:4010

# Optional: company WhatsApp number for the click-to-chat button, in international
# format without +, for example 2547XXXXXXXX. Leave empty to hide the button.
VITE_WHATSAPP_CHAT_NUMBER=
